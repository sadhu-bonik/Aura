<?xml version="1.0" encoding="utf-8"?>
<!--
    Creator Registration - Step 3: Creator Details (Niches / Location / Audience)
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Background Decor -->
    <View
        android:layout_width="384dp"
        android:layout_height="384dp"
        android:background="@drawable/bg_blur_primary"
        android:alpha="0.10"
        android:layout_marginTop="-100dp"
        android:layout_marginStart="-100dp" />

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_app_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:src="@android:drawable/ic_media_previous"
            android:tint="@color/colorPrimary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_marginEnd="@dimen/space_md" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/creator_onboarding_title"
            android:textColor="@color/colorOnSurface"
            android:textSize="20sp"
            android:fontFamily="@font/manrope_extrabold"
            android:letterSpacing="-0.03" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/top_app_bar_height"
        android:paddingBottom="160dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xl">

            <!-- Step header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_step_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STEP 2 OF 3"
                            android:textColor="@color/colorTertiary"
                            android:textSize="11sp"
                            android:fontFamily="@font/manrope_bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.12"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tv_step_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/creator_reg_step3_title"
                            android:textColor="@color/colorOnSurface"
                            android:textSize="32sp"
                            android:fontFamily="@font/manrope_extrabold"
                            android:letterSpacing="-0.02" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_bar"
                    style="@style/Widget.Aura.ProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:progress="66"
                    app:trackCornerRadius="3dp" />
            </LinearLayout>

            <!-- Niches section card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Aura.Card"
                app:cardBackgroundColor="@color/colorSurfaceContainerLow"
                app:cardCornerRadius="24dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorOutlineVariant"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="@dimen/icon_size_md"
                            android:layout_height="@dimen/icon_size_md"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            android:tint="@color/colorPrimary"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/creator_reg_niche_title"
                            android:textColor="@color/colorOnSurface"
                            android:textSize="18sp"
                            android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/creator_reg_niche_desc"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        android:fontFamily="@font/manrope_medium"
                        android:lineSpacingMultiplier="1.5"
                        android:layout_marginBottom="24dp" />

                    <!-- Niche chip buttons -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_niches"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Aura.Card"
                app:cardBackgroundColor="@color/colorSurfaceContainerLow"
                app:cardCornerRadius="24dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorOutlineVariant"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="24dp">

                        <ImageView
                            android:layout_width="@dimen/icon_size_md"
                            android:layout_height="@dimen/icon_size_md"
                            android:src="@android:drawable/ic_menu_mylocation"
                            android:tint="@color/colorPrimary"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/creator_reg_location_title"
                            android:textColor="@color/colorOnSurface"
                            android:textSize="18sp"
                            android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/creator_reg_city_label"
                        android:textColor="@color/colorOutline"
                        android:textSize="11sp"
                        android:fontFamily="@font/manrope_bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp"
                        android:layout_marginStart="4dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_city"
                        style="@style/Widget.Aura.TextInputLayout"
                        app:hintEnabled="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_city"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:hint="@string/creator_reg_city_hint"
                            android:textColorHint="@color/colorOutline"
                            android:fontFamily="@font/manrope_medium"
                            android:textColor="@color/colorOnSurface" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/creator_reg_state_label"
                                android:textColor="@color/colorOutline"
                                android:textSize="11sp"
                                android:fontFamily="@font/manrope_bold"
                                android:textAllCaps="true"
                                android:letterSpacing="0.1"
                                android:layout_marginBottom="8dp"
                                android:layout_marginStart="4dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_state"
                                style="@style/Widget.Aura.TextInputLayout"
                                app:hintEnabled="false"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_state"
                                    android:layout_width="match_parent"
                                    android:layout_height="64dp"
                                    android:hint="@string/creator_reg_state_hint"
                                    android:textColorHint="@color/colorOutline"
                                    android:fontFamily="@font/manrope_medium"
                                    android:textColor="@color/colorOnSurface" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/creator_reg_country_label"
                                android:textColor="@color/colorOutline"
                                android:textSize="11sp"
                                android:fontFamily="@font/manrope_bold"
                                android:textAllCaps="true"
                                android:letterSpacing="0.1"
                                android:layout_marginBottom="8dp"
                                android:layout_marginStart="4dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_country"
                                style="@style/Widget.Aura.TextInputLayout"
                                app:hintEnabled="false"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_country"
                                    android:layout_width="match_parent"
                                    android:layout_height="64dp"
                                    android:hint="@string/creator_reg_country_hint"
                                    android:textColorHint="@color/colorOutline"
                                    android:fontFamily="@font/manrope_medium"
                                    android:textColor="@color/colorOnSurface" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Portfolio link -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/creator_setup_portfolio_link_label"
                android:textColor="@color/colorOutline"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_portfolio_link"
                style="@style/Widget.Aura.TextInputLayout"
                app:hintEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_portfolio_link"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="@string/creator_setup_portfolio_link_hint"
                    android:textColorHint="@color/colorOutline"
                    android:fontFamily="@font/manrope_medium"
                    android:inputType="textUri"
                    android:textColor="@color/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Audience section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Aura.Card"
                app:cardBackgroundColor="@color/colorSurfaceContainerLow"
                app:cardCornerRadius="24dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorOutlineVariant"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="@dimen/icon_size_md"
                            android:layout_height="@dimen/icon_size_md"
                            android:src="@android:drawable/ic_menu_compass"
                            android:tint="@color/colorTertiary"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/creator_reg_audience_title"
                            android:textColor="@color/colorOnSurface"
                            android:textSize="18sp"
                            android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/creator_setup_target_audience_label"
                        android:textColor="@color/colorOutline"
                        android:textSize="11sp"
                        android:fontFamily="@font/manrope_bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp"
                        android:layout_marginStart="4dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_target_audience"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:singleSelection="false" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_audience_region"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:boxBackgroundColor="@color/colorSurfaceContainerHighest"
                        app:boxStrokeWidth="0dp"
                        app:boxCornerRadiusTopStart="32dp"
                        app:boxCornerRadiusTopEnd="32dp"
                        app:boxCornerRadiusBottomStart="32dp"
                        app:boxCornerRadiusBottomEnd="32dp">

                        <AutoCompleteTextView
                            android:id="@+id/acv_audience_region"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:inputType="none"
                            android:text="@string/region_north_america"
                            android:fontFamily="@font/manrope_medium"
                            android:textColor="@color/colorOnSurface" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/layout_bottom_nav"
        layout="@layout/component_reg_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
