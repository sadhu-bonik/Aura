<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/role_top_app_bar_height"
        android:background="@drawable/bg_glass_top_app_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg">

        <ImageButton
            android:id="@+id/iv_back"
            android:layout_width="@dimen/icon_size_xl"
            android:layout_height="@dimen/icon_size_xl"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back_button"
            android:padding="@dimen/space_sm"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/colorOnSurface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:text="@string/creator_setup_top_title"
            android:textAppearance="@style/TextAppearance.Aura.TitleLarge"
            android:textColor="@color/colorOnSurface" />

        <FrameLayout
            android:layout_width="@dimen/creator_top_avatar_size"
            android:layout_height="@dimen/creator_top_avatar_size"
            android:background="@drawable/bg_creator_avatar_small">

            <ImageView
                android:layout_width="@dimen/icon_size_md"
                android:layout_height="@dimen/icon_size_md"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_person"
                android:tint="@color/colorOnSurfaceVariant" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/role_top_app_bar_height"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xxl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/creator_setup_title"
                android:textAppearance="@style/TextAppearance.Aura.DisplayLarge"
                android:textColor="@color/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginBottom="@dimen/space_xxl"
                android:text="@string/creator_setup_subtitle"
                android:textAppearance="@style/TextAppearance.Aura.TitleMedium"
                android:textColor="@color/colorOnSurfaceVariant" />

            <TextView
                style="@style/TextAppearance.Aura.LabelSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/creator_setup_categories_label"
                android:textColor="@color/colorOnSurfaceVariant" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_niches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                app:chipSpacingHorizontal="@dimen/space_sm"
                app:chipSpacingVertical="@dimen/space_sm"
                app:singleSelection="false" />

            <TextView
                android:id="@+id/tv_categories_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xl"
                android:text="@string/error_categories_min_one"
                android:textAppearance="@style/TextAppearance.Aura.Error"
                android:visibility="gone" />

            <TextView
                style="@style/TextAppearance.Aura.LabelSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/creator_setup_target_audience_label"
                android:textColor="@color/colorOnSurfaceVariant" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_target_audience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                app:chipSpacingHorizontal="@dimen/space_sm"
                app:chipSpacingVertical="@dimen/space_sm"
                app:singleSelection="false" />

            <TextView
                android:id="@+id/tv_audience_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xl"
                android:text="@string/error_target_audience_required"
                android:textAppearance="@style/TextAppearance.Aura.Error"
                android:visibility="gone" />

            <TextView
                style="@style/TextAppearance.Aura.LabelSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/creator_setup_location_label"
                android:textColor="@color/colorOnSurfaceVariant" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_location"
                style="@style/Widget.Aura.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xl"
                app:boxBackgroundColor="@color/colorSurfaceContainerLow"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_sm"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_location"
                app:startIconTint="@color/colorOnSurfaceVariant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_location"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:fontFamily="@font/manrope_medium"
                    android:hint="@string/creator_setup_location_hint"
                    android:inputType="textPostalAddress|textCapWords"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOutline" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.Aura.LabelSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/creator_setup_portfolio_link_label"
                android:textColor="@color/colorOnSurfaceVariant" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_portfolio_link"
                style="@style/Widget.Aura.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xl"
                app:boxBackgroundColor="@color/colorSurfaceContainerLow"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_sm"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_sm"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_link"
                app:startIconTint="@color/colorOnSurfaceVariant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_portfolio_link"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:fontFamily="@font/manrope_medium"
                    android:hint="@string/creator_setup_portfolio_link_hint"
                    android:inputType="textUri"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOutline" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_finish_setup"
                style="@style/Widget.Aura.Button.Primary.Gradient"
                android:layout_width="match_parent"
                android:layout_height="@dimen/creator_inline_button_height"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_lg"
                android:background="@drawable/bg_send_deal_gradient_button"
                android:text="@string/nav_btn_finish"
                android:textColor="@color/colorOnSurface"
                app:backgroundTint="@null"
                app:icon="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_exit"
                style="@style/Widget.Aura.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/creator_inline_button_height"
                android:text="@string/nav_btn_save_exit"
                android:textColor="@color/colorOnSurface"
                app:strokeColor="@color/colorOutlineVariant" />
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
