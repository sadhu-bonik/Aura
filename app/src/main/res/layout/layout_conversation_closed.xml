<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cv_conversation_closed"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_md"
    android:layout_marginBottom="@dimen/space_lg"
    android:visibility="gone"
    app:cardBackgroundColor="@color/colorSurfaceContainerHigh"
    app:cardCornerRadius="@dimen/corner_radius_lg"
    app:cardElevation="0dp"
    app:strokeColor="@color/colorDivider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/space_md">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_xs">

            <ImageView
                android:layout_width="@dimen/icon_size_sm"
                android:layout_height="@dimen/icon_size_sm"
                android:src="@drawable/ic_lock"
                app:tint="@color/colorTextSecondary"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:text="@string/conversation_closed_title"
                android:textAppearance="@style/TextAppearance.Aura.LabelSmall"
                android:letterSpacing="0.1"
                android:textAllCaps="true" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_closed_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Aura.BodySmall"
            android:alpha="0.7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_rate_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:textColor="@color/colorOnPrimary"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="@dimen/corner_radius_md"
            app:icon="@drawable/ic_aura_star_outline"
            app:iconTint="@color/colorOnPrimary"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_review_submitted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:drawablePadding="@dimen/space_xs"
            android:gravity="center_vertical"
            android:text="@string/review_already_submitted"
            android:textAppearance="@style/TextAppearance.Aura.LabelMedium"
            android:textColor="@color/colorPrimary"
            app:drawableStartCompat="@drawable/ic_check_circle"
            app:drawableTint="@color/colorPrimary"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
