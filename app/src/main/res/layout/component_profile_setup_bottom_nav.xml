<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_auth_footer_gradient"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_lg"
    android:paddingTop="@dimen/space_lg"
    android:paddingEnd="@dimen/space_lg"
    android:paddingBottom="@dimen/auth_footer_padding_bottom">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_next"
            style="@style/Widget.Aura.Button.Primary.Gradient"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:background="@drawable/bg_send_deal_gradient_button"
            android:text="@string/nav_btn_next"
            android:textColor="@color/white"
            app:backgroundTint="@null"
            app:icon="@null" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/colorOnPrimary"
            app:indicatorSize="24dp"
            app:trackColor="@android:color/transparent"
            app:trackThickness="3dp" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_nav_cancel"
        style="@style/Widget.Aura.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"
        android:text="@string/btn_cancel"
        android:textColor="@color/colorPrimary" />
</LinearLayout>
