<?xml version="1.0" encoding="utf-8"?>
<!--
    Brand Registration - Step 4: Market Presence (Industry Tags + Target Location)
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Background Decor -->
    <View
        android:layout_width="384dp"
        android:layout_height="384dp"
        android:background="@drawable/bg_blur_primary"
        android:alpha="0.10"
        android:layout_marginTop="-100dp"
        android:layout_marginStart="-100dp" />

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_app_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg">

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/colorPrimary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_marginEnd="@dimen/space_md" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/colorPrimary"
            android:textSize="18sp"
            android:fontFamily="@font/manrope_bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Onboarding"
            android:textColor="@color/colorOnSurface"
            android:textSize="11sp"
            android:fontFamily="@font/manrope_bold"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:alpha="0.6" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/top_app_bar_height"
        android:paddingBottom="160dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xl">

            <!-- Progress bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/brand_reg_step4_tag"
                    android:textColor="@color/colorSecondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/manrope_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="75% Complete"
                    android:textColor="@color/colorPrimary"
                    android:textSize="13sp"
                    android:fontFamily="@font/manrope_bold" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_bar"
                style="@style/Widget.Aura.ProgressBar"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:progress="80"
                android:layout_marginBottom="32dp"
                app:trackCornerRadius="3dp" />

            <!-- Headline -->
            <TextView
                android:id="@+id/tv_step_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/brand_reg_step4_title"
                android:textColor="@color/colorOnSurface"
                android:textSize="32sp"
                android:fontFamily="@font/manrope_extrabold"
                android:letterSpacing="-0.02"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/brand_reg_step4_subtitle"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:fontFamily="@font/manrope_medium"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginBottom="40dp" />

            <!-- Industry Tags section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/brand_reg_industry_label"
                android:textColor="@color/colorSecondary"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_industries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:singleSelection="false">
                <!-- Chips populated programmatically from BrandIndustryTags.INDUSTRY_TAGS -->
            </com.google.android.material.chip.ChipGroup>

            <!-- Target audience -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/brand_setup_target_audience_label"
                android:textColor="@color/colorSecondary"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_target_audience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                app:singleSelection="false" />

            <!-- Target Location section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/brand_reg_location_label"
                android:textColor="@color/colorSecondary"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp" />

            <!-- City -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                style="@style/Widget.Aura.Card"
                app:cardBackgroundColor="@color/colorSurfaceContainerLow"
                app:cardCornerRadius="32dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorOutlineVariant"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="24dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_surface"
                        android:backgroundTint="@color/colorSurfaceContainerHighest"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_mylocation"
                            android:tint="@color/colorOutline"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <EditText
                        android:id="@+id/et_city"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/brand_reg_city_hint"
                        android:textColor="@color/colorOnSurface"
                        android:textColorHint="@color/colorOutline"
                        android:fontFamily="@font/manrope_medium"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Region/State + Country (horizontal) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    style="@style/Widget.Aura.Card"
                    app:cardBackgroundColor="@color/colorSurfaceContainerLow"
                    app:cardCornerRadius="32dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/colorOutlineVariant"
                    android:layout_marginEnd="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="16dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_surface"
                            android:backgroundTint="@color/colorSurfaceContainerHighest"
                            android:layout_marginEnd="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_menu_mapmode"
                                android:tint="@color/colorOutline"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <EditText
                            android:id="@+id/et_state"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/brand_reg_state_hint"
                            android:textColor="@color/colorOnSurface"
                            android:textColorHint="@color/colorOutline"
                            android:fontFamily="@font/manrope_medium"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    style="@style/Widget.Aura.Card"
                    app:cardBackgroundColor="@color/colorSurfaceContainerLow"
                    app:cardCornerRadius="32dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/colorOutlineVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="16dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_surface"
                            android:backgroundTint="@color/colorSurfaceContainerHighest"
                            android:layout_marginEnd="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_menu_compass"
                                android:tint="@color/colorOutline"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <EditText
                            android:id="@+id/et_country"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/brand_reg_country_hint"
                            android:textColor="@color/colorOnSurface"
                            android:textColorHint="@color/colorOutline"
                            android:fontFamily="@font/manrope_medium"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Brand Website -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/brand_setup_website_label"
                android:textColor="@color/colorSecondary"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_website"
                style="@style/Widget.Aura.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                android:layout_marginBottom="24dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_website"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="@string/brand_setup_website_hint"
                    android:inputType="textUri"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOutline"
                    android:fontFamily="@font/manrope_medium" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/layout_bottom_nav"
        layout="@layout/component_reg_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
