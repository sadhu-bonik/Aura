<?xml version="1.0" encoding="utf-8"?>
<!--
    Creator Registration - Step 1: Create Account
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Background Decor -->
    <View
        android:layout_width="384dp"
        android:layout_height="384dp"
        android:background="@drawable/bg_blur_primary"
        android:alpha="0.10"
        android:layout_marginTop="-100dp"
        android:layout_marginStart="-100dp" />

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_app_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/colorGradientStart"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/creator_onboarding_title"
            android:textColor="@color/colorOnSurface"
            android:textSize="20sp"
            android:fontFamily="@font/manrope_bold"
            android:letterSpacing="-0.03"
            android:layout_marginStart="@dimen/space_md" />
    </LinearLayout>

    <!-- Scrollable form content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/top_app_bar_height"
        android:paddingBottom="160dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xl">

            <!-- Progress Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_md">

                    <ProgressBar
                        android:id="@+id/pb_video_1"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:visibility="gone"
                        android:indeterminateTint="@color/colorPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_step_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/creator_reg_step1_label"
                            android:textColor="@color/colorTertiary"
                            android:textSize="11sp"
                            android:fontFamily="@font/manrope_bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tv_step_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/creator_reg_step1_title"
                            android:textColor="@color/colorOnSurface"
                            android:textSize="28sp"
                            android:fontFamily="@font/manrope_extrabold"
                            android:letterSpacing="-0.02" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_step_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/creator_reg_step1_tag"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:fontFamily="@font/manrope_medium"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Progress bar – 25% for step 1 of 4 -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_bar"
                    style="@style/Widget.Aura.ProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:progress="25"
                    app:trackCornerRadius="4dp" />
            </LinearLayout>

            <!-- Form start -->

            <!-- Full Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/creator_reg_full_name_label"
                android:textColor="@color/colorOutline"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_full_name"
                style="@style/Widget.Aura.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                android:layout_marginBottom="24dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_full_name"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="@string/creator_reg_full_name_hint"
                    android:textColorHint="@color/colorOutline"
                    android:inputType="textPersonName"
                    android:fontFamily="@font/manrope_medium"
                    android:textColor="@color/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/creator_reg_email_label"
                android:textColor="@color/colorOutline"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                style="@style/Widget.Aura.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                android:layout_marginBottom="24dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="@string/creator_reg_email_hint"
                    android:textColorHint="@color/colorOutline"
                    android:inputType="textEmailAddress"
                    android:fontFamily="@font/manrope_medium"
                    android:textColor="@color/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/creator_reg_password_label"
                android:textColor="@color/colorOutline"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_password"
                style="@style/Widget.Aura.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:hintEnabled="false"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/colorOutline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="••••••••"
                    android:textColorHint="@color/colorOutline"
                    android:inputType="textPassword"
                    android:fontFamily="@font/manrope_medium"
                    android:textColor="@color/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/creator_reg_password_hint"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_medium"
                android:layout_marginBottom="24dp"
                android:layout_marginStart="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/creator_reg_confirm_password_label"
                android:textColor="@color/colorOutline"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_confirm_password"
                style="@style/Widget.Aura.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:hintEnabled="false"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/colorOutline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_confirm_password"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="••••••••"
                    android:textColorHint="@color/colorOutline"
                    android:inputType="textPassword"
                    android:fontFamily="@font/manrope_medium"
                    android:textColor="@color/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone number -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/creator_reg_phone_label"
                android:textColor="@color/colorOutline"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tv_phone_prefix"
                    android:layout_width="80dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center"
                    android:text="@string/creator_reg_phone_prefix"
                    android:textColor="@color/colorOnSurface"
                    android:fontFamily="@font/manrope_bold"
                    android:textSize="16sp"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_phone"
                    style="@style/Widget.Aura.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_phone"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:hint="@string/creator_reg_phone_hint"
                        android:textColorHint="@color/colorOutline"
                        android:inputType="phone"
                        android:fontFamily="@font/manrope_medium"
                        android:textColor="@color/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Security Question -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/creator_reg_security_question_label"
                android:textColor="@color/colorOutline"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_security_question"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:hintEnabled="false"
                app:boxBackgroundColor="@color/colorSurfaceContainerLow"
                app:boxStrokeWidth="0dp"
                app:boxCornerRadiusTopStart="28dp"
                app:boxCornerRadiusTopEnd="28dp"
                app:boxCornerRadiusBottomStart="28dp"
                app:boxCornerRadiusBottomEnd="28dp">

                <AutoCompleteTextView
                    android:id="@+id/acv_security_question"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:inputType="none"
                    android:fontFamily="@font/manrope_medium"
                    android:textColor="@color/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Security Answer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/creator_reg_security_answer_label"
                android:textColor="@color/colorOutline"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_security_answer"
                style="@style/Widget.Aura.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                android:layout_marginBottom="32dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_security_answer"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="@string/creator_reg_security_answer_hint"
                    android:textColorHint="@color/colorOutline"
                    android:inputType="text"
                    android:fontFamily="@font/manrope_medium"
                    android:textColor="@color/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Cancel link -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                style="@style/Widget.Aura.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/creator_reg_cancel_link"
                android:textColor="@color/colorOutline" />

        </LinearLayout>
    </ScrollView>

    <!-- Fixed bottom nav bar -->
    <include
        android:id="@+id/layout_bottom_nav"
        layout="@layout/component_reg_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
