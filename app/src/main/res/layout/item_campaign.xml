<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/colorOutlineVariant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp">

            <ImageView
                android:id="@+id/iv_campaign_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_pill_surface_low" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_overlay" />

            <!-- action buttons row: edit (left) and delete X (right) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_campaign"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:backgroundTint="#4D000000"
                    app:icon="@drawable/ic_edit"
                    app:iconSize="16dp"
                    app:iconTint="@color/colorOnPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_delete_campaign"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#4D000000"
                    app:icon="@drawable/ic_close"
                    app:iconSize="16dp"
                    app:iconTint="@color/colorOnPrimary" />

            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_campaign_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Campaign Title"
                android:textColor="@color/colorOnSurface"
                android:textSize="16sp"
                android:fontFamily="@font/manrope_bold" />

            <TextView
                android:id="@+id/tv_campaign_budget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="$500 - $1000"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:fontFamily="@font/manrope_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
