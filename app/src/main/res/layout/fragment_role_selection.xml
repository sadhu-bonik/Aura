<?xml version="1.0" encoding="utf-8"?>
<!--
    Role Selection Screen
    Design ref: role_selection
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Background Decor -->
    <View
        android:layout_width="384dp"
        android:layout_height="384dp"
        android:background="@drawable/bg_blur_primary"
        android:alpha="0.10"
        android:layout_marginTop="-100dp"
        android:layout_marginStart="-100dp" />

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_app_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/colorGradientStart"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aura"
            android:textColor="@color/colorOnSurface"
            android:textSize="20sp"
            android:fontFamily="@font/manrope_bold"
            android:letterSpacing="-0.03"
            android:layout_marginStart="@dimen/space_md" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollview_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/top_app_bar_height"
        android:layout_marginBottom="120dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xl">

            <!-- Headline section -->
            <TextView
                android:id="@+id/tv_join_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/role_selection_title"
                android:textColor="@color/colorOnSurface"
                android:textSize="36sp"
                android:fontFamily="@font/manrope_extrabold"
                android:letterSpacing="-0.02"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_join_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/role_selection_subtitle"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="16sp"
                android:fontFamily="@font/manrope_medium"
                android:layout_marginBottom="32dp" />

            <!-- CREATOR card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_creator"
                style="@style/Widget.Aura.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorSurfaceContainerLow"
                app:cardCornerRadius="24dp"
                android:layout_marginBottom="@dimen/space_lg"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_xl">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/space_md">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_circle_primary_tint"
                            android:backgroundTint="@color/colorPrimary">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/star_on"
                                android:tint="@color/colorOnPrimary" />
                        </FrameLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:id="@+id/iv_creator_check"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/checkbox_on_background"
                            android:tint="@color/colorPrimary"
                            android:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_creator_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/role_creator_title"
                        android:textColor="@color/colorOnSurface"
                        android:textSize="22sp"
                        android:fontFamily="@font/manrope_bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_creator_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/role_creator_desc"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        android:fontFamily="@font/manrope_medium"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tv_creator_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/role_creator_tag"
                        android:textColor="@color/colorPrimary"
                        android:textSize="11sp"
                        android:fontFamily="@font/manrope_bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BRAND card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_brand"
                style="@style/Widget.Aura.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorOutlineVariant"
                app:cardCornerRadius="24dp"
                android:layout_marginBottom="32dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_xl">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/space_md">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_circle_primary_tint"
                            android:backgroundTint="@color/colorTertiaryContainer">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_menu_manage"
                                android:tint="@color/colorOnTertiaryContainer" />
                        </FrameLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:id="@+id/iv_brand_check"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/checkbox_on_background"
                            android:tint="@color/colorTertiary"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_brand_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/role_brand_title"
                        android:textColor="@color/colorOnSurface"
                        android:textSize="22sp"
                        android:fontFamily="@font/manrope_bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_brand_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/role_brand_desc"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        android:fontFamily="@font/manrope_medium"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tv_brand_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/role_brand_tag"
                        android:textColor="@color/colorTertiary"
                        android:textSize="11sp"
                        android:fontFamily="@font/manrope_bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Note info bar -->
            <LinearLayout
                android:id="@+id/layout_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_md"
                android:background="@drawable/bg_card_surface"
                android:layout_marginBottom="@dimen/space_lg">

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@android:drawable/ic_dialog_info"
                    android:tint="@color/colorTertiary"
                    android:layout_marginEnd="@dimen/space_md" />

                <TextView
                    android:id="@+id/tv_role_note"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/role_selection_note"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:fontFamily="@font/manrope_medium" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Actions bar -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:paddingTop="16dp"
        android:paddingBottom="32dp"
        android:background="@color/colorBackground"
        android:layout_gravity="bottom">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_continue"
            style="@style/Widget.Aura.Button.Primary.Gradient"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/role_selection_continue_btn"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.Aura.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:strokeColor="#33494650"
            android:textColor="@color/colorOnSurfaceVariant"
            android:text="@string/role_selection_back_btn" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
