<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/role_top_app_bar_height"
        android:background="@drawable/bg_glass_top_app_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/iv_back"
                android:layout_width="@dimen/icon_size_xl"
                android:layout_height="@dimen/icon_size_xl"
                android:layout_marginStart="@dimen/role_back_margin_start"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back_button"
                android:padding="@dimen/space_sm"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/colorRoleViolet" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:text="@string/role_selection_top_title"
                android:textAppearance="@style/TextAppearance.Aura.TitleMedium"
                android:textColor="@color/colorOnSurface" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_extrabold"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/colorOnSurface"
            android:textAppearance="@style/TextAppearance.Aura.TitleLarge" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollview_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/role_top_app_bar_height"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/auth_content_bottom_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xl"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_join_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:text="@string/role_selection_title"
                    android:textAppearance="@style/TextAppearance.Aura.DisplayLarge"
                    android:textColor="@color/colorOnSurface" />

                <TextView
                    android:id="@+id/tv_join_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/role_selection_subtitle"
                    android:textAppearance="@style/TextAppearance.Aura.TitleMedium"
                    android:textColor="@color/colorOnSurfaceVariant" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_creator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xl"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/role_card_min_height"
                app:cardBackgroundColor="@color/colorRoleCard"
                app:cardCornerRadius="@dimen/role_card_corner_radius"
                app:cardElevation="0dp"
                app:rippleColor="@color/colorRoleViolet"
                app:strokeColor="@color/colorRoleViolet"
                app:strokeWidth="@dimen/role_card_selected_stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/role_card_min_height"
                    android:orientation="vertical"
                    android:padding="@dimen/role_card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_lg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/layout_creator_icon"
                            android:layout_width="@dimen/role_icon_container_size"
                            android:layout_height="@dimen/role_icon_container_size"
                            android:background="@drawable/bg_role_icon_selected">

                            <ImageView
                                android:id="@+id/iv_creator_icon"
                                android:layout_width="@dimen/role_icon_size"
                                android:layout_height="@dimen/role_icon_size"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_account_circle"
                                android:tint="@color/colorRoleViolet" />
                        </FrameLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="@dimen/input_stroke_width_none"
                            android:layout_weight="1" />

                        <FrameLayout
                            android:id="@+id/radio_creator"
                            android:layout_width="@dimen/role_radio_size"
                            android:layout_height="@dimen/role_radio_size"
                            android:background="@drawable/bg_role_radio_selected">

                            <View
                                android:id="@+id/view_creator_dot"
                                android:layout_width="@dimen/role_radio_dot_size"
                                android:layout_height="@dimen/role_radio_dot_size"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_role_radio_dot" />
                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_creator_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="@string/role_creator_title"
                        android:textAppearance="@style/TextAppearance.Aura.RoleCardTitle" />

                    <TextView
                        android:id="@+id/tv_creator_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/role_creator_desc"
                        android:textAppearance="@style/TextAppearance.Aura.BodyLarge"
                        android:textColor="@color/colorRoleMuted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_brand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/role_card_min_height"
                app:cardBackgroundColor="@color/colorRoleCard"
                app:cardCornerRadius="@dimen/role_card_corner_radius"
                app:cardElevation="0dp"
                app:rippleColor="@color/colorRoleViolet"
                app:strokeColor="@color/colorRoleBorder"
                app:strokeWidth="@dimen/role_card_unselected_stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/role_card_min_height"
                    android:orientation="vertical"
                    android:padding="@dimen/role_card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_lg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/layout_brand_icon"
                            android:layout_width="@dimen/role_icon_container_size"
                            android:layout_height="@dimen/role_icon_container_size"
                            android:background="@drawable/bg_role_icon_unselected">

                            <ImageView
                                android:id="@+id/iv_brand_icon"
                                android:layout_width="@dimen/role_icon_size"
                                android:layout_height="@dimen/role_icon_size"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_campaign"
                                android:tint="@color/colorRoleMuted" />
                        </FrameLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="@dimen/input_stroke_width_none"
                            android:layout_weight="1" />

                        <FrameLayout
                            android:id="@+id/radio_brand"
                            android:layout_width="@dimen/role_radio_size"
                            android:layout_height="@dimen/role_radio_size"
                            android:background="@drawable/bg_role_radio_unselected">

                            <View
                                android:id="@+id/view_brand_dot"
                                android:layout_width="@dimen/role_radio_dot_size"
                                android:layout_height="@dimen/role_radio_dot_size"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_role_radio_dot"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_brand_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="@string/role_brand_title"
                        android:textAppearance="@style/TextAppearance.Aura.RoleCardTitle" />

                    <TextView
                        android:id="@+id/tv_brand_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/role_brand_desc"
                        android:textAppearance="@style/TextAppearance.Aura.BodyLarge"
                        android:textColor="@color/colorRoleMuted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_xl" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/colorBackground"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/role_footer_top_padding"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/auth_footer_padding_bottom">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_continue"
            style="@style/Widget.Aura.Button.Primary.Gradient"
            android:layout_width="match_parent"
            android:layout_height="@dimen/role_footer_button_height"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@drawable/bg_send_deal_gradient_button"
            android:text="@string/role_selection_continue_btn"
            android:textAppearance="@style/TextAppearance.Aura.RoleFooterButton"
            android:textColor="@color/white"
            app:backgroundTint="@null"
            app:icon="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.Aura.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:text="@string/role_selection_back_btn"
            android:textColor="@color/colorRoleMuted" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
