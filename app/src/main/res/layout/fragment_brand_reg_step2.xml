<?xml version="1.0" encoding="utf-8"?>
<!--
    Brand Registration - Step 2: Brand Identity
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Background Decor -->
    <View
        android:layout_width="384dp"
        android:layout_height="384dp"
        android:background="@drawable/bg_blur_primary"
        android:alpha="0.10"
        android:layout_marginTop="-100dp"
        android:layout_marginStart="-100dp" />

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_app_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg">

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/colorOnSurface"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/login_title"
            android:textColor="@color/colorPrimary"
            android:textSize="18sp"
            android:fontFamily="@font/manrope_bold"
            android:layout_marginStart="@dimen/space_md" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Onboarding"
            android:textColor="@color/colorOnSurface"
            android:textSize="11sp"
            android:fontFamily="@font/manrope_bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:alpha="0.6" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/top_app_bar_height"
        android:paddingBottom="160dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xl">

            <!-- Step header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="32dp">

                <TextView
                    android:id="@+id/tv_step_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_reg_step2_tag"
                    android:textColor="@color/colorTertiary"
                    android:textSize="12sp"
                    android:fontFamily="@font/manrope_bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_step_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_reg_step2_title"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="36sp"
                    android:fontFamily="@font/manrope_extrabold"
                    android:letterSpacing="-0.03"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_reg_step2_subtitle"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="14sp"
                    android:fontFamily="@font/manrope_medium"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>

            <!-- Logo upload section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Aura.Card"
                app:cardBackgroundColor="@color/colorSurfaceContainerLowest"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorOutlineVariant"
                app:cardCornerRadius="24dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_reg_logo_label"
                        android:textColor="@color/colorOnSurface"
                        android:textSize="16sp"
                        android:fontFamily="@font/manrope_bold"
                        android:layout_marginBottom="24dp" />

                    <!-- Circular logo upload zone -->
                    <FrameLayout
                        android:id="@+id/layout_logo_upload"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/bg_circle_surface"
                        android:backgroundTint="@color/colorSurfaceContainerHighest"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:id="@+id/layout_logo_prompt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <ImageView
                                android:layout_width="@dimen/icon_size_xl"
                                android:layout_height="@dimen/icon_size_xl"
                                android:src="@android:drawable/ic_menu_camera"
                                android:tint="@color/colorOnSurfaceVariant"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/brand_reg_upload_logo_label"
                                android:textColor="@color/colorOnSurfaceVariant"
                                android:fontFamily="@font/manrope_bold"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/iv_logo_preview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_reg_logo_spec"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="11sp"
                        android:fontFamily="@font/manrope_medium"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.4" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Editorial Tip -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Aura.Card"
                app:cardBackgroundColor="@color/colorSurfaceContainerLow"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="@dimen/icon_size_md"
                            android:layout_height="@dimen/icon_size_md"
                            android:src="@android:drawable/ic_dialog_info"
                            android:tint="@color/colorTertiary"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/brand_reg_editorial_tip_title"
                            android:textColor="@color/colorOnSurface"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_reg_editorial_tip_body"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:fontFamily="@font/manrope_medium"
                        android:lineSpacingMultiplier="1.5" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Core Identity fields section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Core Identity"
                android:textColor="@color/colorOnSurface"
                android:textSize="18sp"
                android:fontFamily="@font/manrope_bold"
                android:layout_marginBottom="24dp" />

            <!-- Brand Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/brand_setup_brand_name_label"
                android:textColor="@color/colorOutline"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_brand_name"
                style="@style/Widget.Aura.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                android:layout_marginBottom="24dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_brand_name"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="@string/brand_setup_brand_name_hint"
                    android:textColorHint="@color/colorOutline"
                    android:inputType="text"
                    android:fontFamily="@font/manrope_medium"
                    android:textColor="@color/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Motto -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/brand_reg_motto_label"
                android:textColor="@color/colorOutline"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_motto"
                style="@style/Widget.Aura.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                android:layout_marginBottom="24dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_motto"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="@string/brand_reg_motto_hint"
                    android:textColorHint="@color/colorOutline"
                    android:inputType="text"
                    android:fontFamily="@font/manrope_medium"
                    android:textColor="@color/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Bio -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/brand_reg_bio_label"
                android:textColor="@color/colorOutline"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_bio"
                style="@style/Widget.Aura.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                android:layout_marginBottom="4dp"
                app:boxCornerRadiusTopStart="24dp"
                app:boxCornerRadiusTopEnd="24dp"
                app:boxCornerRadiusBottomStart="24dp"
                app:boxCornerRadiusBottomEnd="24dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_bio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="5"
                    android:hint="@string/brand_reg_bio_hint"
                    android:textColorHint="@color/colorOutline"
                    android:inputType="textMultiLine"
                    android:gravity="top"
                    android:paddingTop="16dp"
                    android:fontFamily="@font/manrope_medium"
                    android:textColor="@color/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/brand_reg_bio_char_limit"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="10sp"
                android:fontFamily="@font/manrope_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:gravity="end"
                android:layout_marginBottom="24dp" />

            <!-- Business license -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="32dp"
                    android:layout_height="1dp"
                    android:background="@color/colorPrimary"
                    android:alpha="0.3"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_reg_step3_doc_section"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="10sp"
                    android:fontFamily="@font/manrope_bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.2" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/layout_file_upload"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_upload_zone"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:id="@+id/layout_file_prompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_circle_primary_tint"
                        android:backgroundTint="@color/colorPrimaryContainer"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_upload"
                            android:tint="@color/colorPrimary"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_reg_step3_upload_title"
                        android:textColor="@color/colorOnSurface"
                        android:textSize="16sp"
                        android:fontFamily="@font/manrope_bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_reg_step3_upload_subtitle"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:fontFamily="@font/manrope_medium"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_file_selected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:padding="8dp"
                    android:gravity="center"
                    android:textColor="@color/colorPrimary"
                    android:textSize="13sp"
                    android:fontFamily="@font/manrope_bold"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/layout_bottom_nav"
        layout="@layout/component_profile_setup_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
