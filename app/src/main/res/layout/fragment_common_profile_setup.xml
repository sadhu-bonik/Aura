<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_app_bar_height"
        android:background="@drawable/bg_glass_top_app_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg">

        <ImageButton
            android:id="@+id/iv_back"
            android:layout_width="@dimen/icon_size_xl"
            android:layout_height="@dimen/icon_size_xl"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back_button"
            android:padding="@dimen/space_sm"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/colorGradientStart" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:text="@string/creator_reg_step1_title"
            android:textAppearance="@style/TextAppearance.Aura.TitleLarge"
            android:textColor="@color/white" />

        <Space
            android:layout_width="@dimen/icon_size_xl"
            android:layout_height="@dimen/icon_size_xl" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/top_app_bar_height"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/auth_content_bottom_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xl"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:text="@string/common_profile_title"
                    android:textAppearance="@style/TextAppearance.Aura.DisplayLarge"
                    android:textColor="@color/colorOnSurface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/common_profile_subtitle"
                    android:textAppearance="@style/TextAppearance.Aura.BodyLarge"
                    android:textColor="@color/colorOnSurfaceVariant" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/common_first_name_label"
                android:textAppearance="@style/TextAppearance.Aura.LabelLarge"
                android:textColor="@color/colorOnSurfaceVariant" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_first_name"
                style="@style/Widget.Aura.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                app:boxBackgroundColor="@color/colorSurfaceContainer"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_first_name"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:fontFamily="@font/manrope_medium"
                    android:hint="@string/common_first_name_hint"
                    android:inputType="textPersonName|textCapWords"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOutline" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/common_last_name_label"
                android:textAppearance="@style/TextAppearance.Aura.LabelLarge"
                android:textColor="@color/colorOnSurfaceVariant" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_last_name"
                style="@style/Widget.Aura.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                app:boxBackgroundColor="@color/colorSurfaceContainerLow"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_last_name"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:fontFamily="@font/manrope_medium"
                    android:hint="@string/common_last_name_hint"
                    android:inputType="textPersonName|textCapWords"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOutline" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/common_phone_label"
                android:textAppearance="@style/TextAppearance.Aura.LabelLarge"
                android:textColor="@color/colorOnSurfaceVariant" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_phone"
                style="@style/Widget.Aura.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                app:boxBackgroundColor="@color/colorSurfaceContainerLow"
                app:endIconDrawable="@drawable/ic_call"
                app:endIconMode="custom"
                app:endIconTint="@color/colorErrorDim"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_phone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:fontFamily="@font/manrope_medium"
                    android:hint="@string/common_phone_hint"
                    android:inputType="phone"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOutline" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/common_security_question_label"
                android:textAppearance="@style/TextAppearance.Aura.LabelLarge"
                android:textColor="@color/colorOnSurfaceVariant" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_security_question"
                style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                app:boxBackgroundColor="@color/colorSurfaceContainer"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_xl"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_xl"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_xl"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_xl"
                app:boxStrokeColor="@color/colorPrimary"
                app:boxStrokeWidth="@dimen/input_stroke_width_none"
                app:boxStrokeWidthFocused="@dimen/input_stroke_width_focused"
                app:endIconTint="@color/colorOutline"
                app:errorIconDrawable="@null"
                app:errorTextAppearance="@style/TextAppearance.Aura.Error"
                app:errorTextColor="@color/colorErrorDim"
                app:hintEnabled="false">

                <AutoCompleteTextView
                    android:id="@+id/acv_security_question"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:backgroundTint="@android:color/transparent"
                    android:fontFamily="@font/manrope_medium"
                    android:inputType="none"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg"
                    android:popupBackground="@color/colorSurfaceContainerHigh"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOutline" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/common_security_answer_label"
                android:textAppearance="@style/TextAppearance.Aura.LabelLarge"
                android:textColor="@color/colorOnSurfaceVariant" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_security_answer"
                style="@style/Widget.Aura.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundColor="@color/colorSurfaceContainerLow"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_security_answer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:fontFamily="@font/manrope_medium"
                    android:hint="@string/common_security_answer_hint"
                    android:inputType="text"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOutline" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layout_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_auth_footer_gradient"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/auth_footer_padding_bottom">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next"
            style="@style/Widget.Aura.Button.Primary.Gradient"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginBottom="@dimen/space_sm"
            android:background="@drawable/bg_send_deal_gradient_button"
            android:text="@string/nav_btn_next"
            android:textColor="@color/white"
            app:backgroundTint="@null"
            app:icon="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/Widget.Aura.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:text="@string/btn_cancel"
            android:textColor="@color/colorPrimary" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
