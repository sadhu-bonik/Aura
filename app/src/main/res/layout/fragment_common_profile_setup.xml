<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <View
        android:layout_width="384dp"
        android:layout_height="384dp"
        android:layout_marginStart="-100dp"
        android:layout_marginTop="-100dp"
        android:alpha="0.10"
        android:background="@drawable/bg_blur_primary"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_app_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back_button"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:fontFamily="@font/manrope_bold"
            android:text="@string/creator_onboarding_title"
            android:textColor="@color/colorOnSurface"
            android:textSize="18sp" />

        <ImageView
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/colorOnSurface" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/top_app_bar_height"
        android:fillViewport="true"
        android:paddingBottom="160dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_xs"
                        android:fontFamily="@font/manrope_bold"
                        android:text="@string/common_profile_step_label"
                        android:textAllCaps="true"
                        android:textColor="@color/colorTertiary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_extrabold"
                        android:text="@string/common_profile_title"
                        android:textColor="@color/colorOnSurface"
                        android:textSize="32sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_medium"
                    android:text="@string/common_profile_step_count"
                    android:textColor="@color/colorSecondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                style="@style/Widget.Aura.ProgressBar"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginBottom="@dimen/space_xl"
                android:progress="50"
                app:trackCornerRadius="3dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="172dp"
                android:layout_marginBottom="@dimen/space_xl"
                android:background="@drawable/bg_cover_gradient"
                android:clipToOutline="true">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.28"
                    android:background="@drawable/bg_aura_gradient_primary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_marginBottom="@dimen/space_lg"
                    android:fontFamily="@font/manrope_medium"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/common_profile_hero_body"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="14sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:fontFamily="@font/manrope_bold"
                    android:text="@string/common_first_name_label"
                    android:textAllCaps="true"
                    android:textColor="@color/colorSecondary"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_first_name"
                    style="@style/Widget.Aura.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_lg"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_first_name"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:fontFamily="@font/manrope_medium"
                        android:hint="@string/common_first_name_hint"
                        android:inputType="textPersonName"
                        android:textColor="@color/colorOnSurface"
                        android:textColorHint="@color/colorOutline" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:fontFamily="@font/manrope_bold"
                    android:text="@string/common_last_name_label"
                    android:textAllCaps="true"
                    android:textColor="@color/colorSecondary"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_last_name"
                    style="@style/Widget.Aura.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_lg"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_last_name"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:fontFamily="@font/manrope_medium"
                        android:hint="@string/common_last_name_hint"
                        android:inputType="textPersonName"
                        android:textColor="@color/colorOnSurface"
                        android:textColorHint="@color/colorOutline" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:fontFamily="@font/manrope_bold"
                    android:text="@string/common_phone_label"
                    android:textAllCaps="true"
                    android:textColor="@color/colorSecondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_lg"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="88dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="@font/manrope_medium"
                        android:gravity="center"
                        android:text="@string/common_profile_phone_prefix"
                        android:textColor="@color/colorOnSurface"
                        android:textSize="16sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_phone"
                        style="@style/Widget.Aura.TextInputLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_phone"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:fontFamily="@font/manrope_medium"
                            android:hint="@string/common_phone_hint"
                            android:inputType="phone"
                            android:textColor="@color/colorOnSurface"
                            android:textColorHint="@color/colorOutline" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="@dimen/space_md"
                    android:fontFamily="@font/manrope_bold"
                    android:text="@string/common_profile_security_section"
                    android:textAllCaps="true"
                    android:textColor="@color/colorSecondary"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_security_question"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_lg"
                    app:boxBackgroundColor="@color/colorSurfaceContainerHighest"
                    app:boxCornerRadiusBottomEnd="@dimen/corner_radius_sm"
                    app:boxCornerRadiusBottomStart="@dimen/corner_radius_sm"
                    app:boxCornerRadiusTopEnd="@dimen/corner_radius_sm"
                    app:boxCornerRadiusTopStart="@dimen/corner_radius_sm"
                    app:boxStrokeWidth="0dp"
                    app:hintEnabled="false">

                    <AutoCompleteTextView
                        android:id="@+id/acv_security_question"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:fontFamily="@font/manrope_medium"
                        android:inputType="none"
                        android:textColor="@color/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:fontFamily="@font/manrope_bold"
                    android:text="@string/common_security_answer_label"
                    android:textAllCaps="true"
                    android:textColor="@color/colorSecondary"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_security_answer"
                    style="@style/Widget.Aura.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_security_answer"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:fontFamily="@font/manrope_medium"
                        android:hint="@string/common_security_answer_hint"
                        android:inputType="text"
                        android:textColor="@color/colorOnSurface"
                        android:textColorHint="@color/colorOutline" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/layout_bottom_nav"
        layout="@layout/component_reg_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
