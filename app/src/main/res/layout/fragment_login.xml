<?xml version="1.0" encoding="utf-8"?>
<!--
    Login Screen
    Design ref: aura_login_refined
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/space_xxl">

            <!-- Background Decor -->
            <View
                android:layout_width="384dp"
                android:layout_height="384dp"
                android:background="@drawable/bg_blur_primary"
                android:alpha="0.10"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="-100dp"
                android:layout_marginEnd="-100dp" />

            <View
                android:layout_width="256dp"
                android:layout_height="256dp"
                android:background="@drawable/bg_blur_primary"
                android:backgroundTint="#5620e0"
                android:alpha="0.10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginBottom="-50dp"
                android:layout_marginStart="-50dp" />

            <!-- Top Navigation Bar -->
            <LinearLayout
                android:id="@+id/layout_top_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/top_app_bar_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/iv_back"
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@android:drawable/ic_menu_revert"
                    android:tint="@color/colorGradientStart"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aura"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="20sp"
                    android:fontFamily="@font/manrope_bold"
                    android:letterSpacing="-0.03"
                    android:layout_marginStart="@dimen/space_md" />
            </LinearLayout>

            <!-- Main Content Area -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="@dimen/space_xl"
                android:paddingEnd="@dimen/space_xl"
                android:layout_marginTop="@dimen/space_xxl"
                app:layout_constraintTop_toBottomOf="@id/layout_top_bar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- User Info Section -->
                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginBottom="@dimen/space_lg">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="48dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardElevation="0dp"
                        android:layout_margin="4dp">

                        <ImageView
                            android:id="@+id/iv_user_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@android:drawable/ic_menu_myplaces"
                            android:background="@color/colorSurfaceContainerHighest" />
                    </androidx.cardview.widget.CardView>

                    <!-- Selection border effect -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_gradient_ring" />

                    <!-- Verified Badge -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|end"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:tint="@color/colorOnPrimary"
                        android:background="@drawable/bg_circle_primary_tint"
                        android:backgroundTint="@color/colorPrimary"
                        android:padding="2dp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_welcome_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back"
                    android:textColor="@color/colorOnBackground"
                    android:textSize="36sp"
                    android:fontFamily="@font/manrope_extrabold"
                    android:letterSpacing="-0.02"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_user_email_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logged in as: user@aura.com"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="18sp"
                    android:fontFamily="@font/manrope_medium"
                    android:layout_marginBottom="48dp" />

                <!-- Password Input Group -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_password"
                    style="@style/Widget.Aura.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/colorOutline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_password"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:hint="Enter your password"
                        android:textColorHint="@color/colorOutline"
                        android:inputType="textPassword"
                        android:textColor="@color/colorOnSurface"
                        android:fontFamily="@font/manrope_medium"
                        android:imeOptions="actionDone" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Helper Text -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tv_password_error"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="@color/colorError"
                        android:textSize="12sp"
                        android:fontFamily="@font/manrope_medium"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="32dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_login"
                        style="@style/Widget.Aura.Button.Primary.Gradient"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="Login"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tv_forgot_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Forgot Password?"
                        android:textColor="@color/colorPrimary"
                        android:textSize="14sp"
                        android:fontFamily="@font/manrope_semibold"
                        android:gravity="center"
                        android:paddingTop="@dimen/space_md"
                        android:paddingBottom="@dimen/space_md"
                        android:layout_marginTop="@dimen/space_sm"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Cancel Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                style="@style/Widget.Aura.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="@dimen/space_xl"
                android:layout_marginEnd="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_xxl"
                app:strokeColor="#33494650"
                android:text="Cancel"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
