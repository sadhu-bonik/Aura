<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_edit_profile"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Edit Profile"
            app:titleCentered="true"
            app:titleTextColor="@color/colorOnSurface"
            app:navigationIcon="@drawable/ic_arrow_back" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingBottom="120dp">

            <!-- Hero Visual Section -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginBottom="32dp"
                android:gravity="center">

                <FrameLayout
                    android:id="@+id/btn_upload_photo"
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_surface"
                    android:backgroundTint="@color/colorSurfaceContainerHighest"
                    android:clickable="true"
                    android:focusable="true">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_edit_photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                    <!-- Edit Badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="bottom|end"
                        app:cardBackgroundColor="@color/colorPrimary"
                        app:cardCornerRadius="18dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/colorSurface">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_edit"
                            android:tint="@color/colorOnPrimary" />
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>
            </FrameLayout>

            <!-- Name Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FULL NAME"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_name"
                style="@style/Widget.Aura.TextInputLayout"
                app:hintEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_name"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="Full Name"
                    android:inputType="textPersonName"
                    android:fontFamily="@font/manrope_medium"
                    android:textColor="@color/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Headline Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HEADLINE"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_headline"
                style="@style/Widget.Aura.TextInputLayout"
                app:hintEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_headline"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="Digital Creator"
                    android:inputType="text"
                    android:fontFamily="@font/manrope_medium"
                    android:textColor="@color/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Bio Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BIO"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_bio"
                style="@style/Widget.Aura.TextInputLayout"
                app:hintEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_bio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="120dp"
                    android:gravity="top|start"
                    android:hint="Tell your story"
                    android:inputType="textMultiLine"
                    android:fontFamily="@font/manrope_medium"
                    android:textColor="@color/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PHONE NUMBER"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_phone"
                style="@style/Widget.Aura.TextInputLayout"
                app:hintEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/ic_call"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_phone"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="+1 (555) 000-0000"
                    android:inputType="phone"
                    android:fontFamily="@font/manrope_medium"
                    android:textColor="@color/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Security Question -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SECURITY QUESTION"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_security_question"
                style="@style/Widget.Aura.TextInputLayout"
                app:hintEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/et_security_question"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="Select a security question"
                    android:inputType="none"
                    android:fontFamily="@font/manrope_medium"
                    android:textColor="@color/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Security Answer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SECURITY ANSWER"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_security_answer"
                style="@style/Widget.Aura.TextInputLayout"
                app:hintEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_security_answer"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="Your answer"
                    android:inputType="text"
                    android:fontFamily="@font/manrope_medium"
                    android:textColor="@color/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Niche Tags (Common) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NICHE TAGS (MAX 5)"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="16dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_edit_niche_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp" />

            <!-- Brand Website (Brands Only) -->
            <LinearLayout
                android:id="@+id/layout_brand_website"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BRAND WEBSITE"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    android:fontFamily="@font/manrope_bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="16dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_website"
                    style="@style/Widget.Aura.TextInputLayout"
                    app:hintEnabled="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:startIconDrawable="@drawable/ic_search"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_website"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:hint="https://yourbrand.com"
                        android:inputType="textUri"
                        android:fontFamily="@font/manrope_medium"
                        android:textColor="@color/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Industry Category (Brands Only) -->
            <LinearLayout
                android:id="@+id/layout_brand_industry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INDUSTRY / CATEGORY"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    android:fontFamily="@font/manrope_bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="16dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_industry"
                    style="@style/Widget.Aura.TextInputLayout"
                    app:hintEnabled="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_industry"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:hint="e.g. Fashion, Tech"
                        android:inputType="text"
                        android:fontFamily="@font/manrope_medium"
                        android:textColor="@color/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>


            <!-- YouTube URL (Creators Only) -->
            <LinearLayout
                android:id="@+id/layout_creator_youtube"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUTUBE"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    android:fontFamily="@font/manrope_bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="16dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_youtube"
                    style="@style/Widget.Aura.TextInputLayout"
                    app:hintEnabled="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:startIconDrawable="@drawable/ic_feed_play"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_youtube"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:hint="YouTube channel link"
                        android:inputType="textUri"
                        android:fontFamily="@font/manrope_medium"
                        android:textColor="@color/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Widget.Aura.Button.Primary.Gradient"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Save Changes"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <!-- Delete Profile Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_profile"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="@string/btn_delete_account"
                android:textColor="@color/colorError"
                app:strokeColor="#33f97386"
                app:backgroundTint="#0Df97386"
                android:textSize="14sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Full Screen Loading Overlay -->
    <include
        android:id="@+id/layout_loading"
        layout="@layout/layout_loading"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
