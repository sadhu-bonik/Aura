<?xml version="1.0" encoding="utf-8"?>
<!--
    Brand Registration - Step 3: Company Verification
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Background Decor -->
    <View
        android:layout_width="384dp"
        android:layout_height="384dp"
        android:background="@drawable/bg_blur_primary"
        android:alpha="0.10"
        android:layout_marginTop="-100dp"
        android:layout_marginStart="-100dp" />

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_app_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg">

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="@dimen/icon_size_md"
            android:layout_height="@dimen/icon_size_md"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/colorPrimary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_marginEnd="@dimen/space_md" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/colorOnSurface"
            android:textSize="20sp"
            android:fontFamily="@font/manrope_extrabold"
            android:letterSpacing="-0.03" />

        <!-- PRO badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRO"
            android:textColor="@color/colorTertiary"
            android:textSize="10sp"
            android:fontFamily="@font/manrope_bold"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_pill_tertiary_container" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/top_app_bar_height"
        android:paddingBottom="160dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xl">

            <!-- Progress indicator segmented -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Onboarding"
                            android:textColor="@color/colorPrimary"
                            android:textSize="11sp"
                            android:fontFamily="@font/manrope_bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.15"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:id="@+id/tv_step_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/brand_reg_step3_verify_title"
                            android:textColor="@color/colorOnSurface"
                            android:textSize="26sp"
                            android:fontFamily="@font/manrope_extrabold"
                            android:letterSpacing="-0.02" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_reg_step3_tag"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        android:fontFamily="@font/manrope_bold" />
                </LinearLayout>

                <!-- Segmented progress bar (5 segments) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:orientation="horizontal">

                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/colorPrimary" android:layout_marginEnd="4dp" app:trackCornerRadius="3dp" />
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/colorPrimary" android:layout_marginEnd="4dp" app:trackCornerRadius="3dp" />
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/colorPrimary" android:layout_marginEnd="4dp" app:trackCornerRadius="3dp" />
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/colorSurfaceContainerHighest" android:layout_marginEnd="4dp" app:trackCornerRadius="3dp" />
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/colorSurfaceContainerHighest" app:trackCornerRadius="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Entity Credentials section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View android:layout_width="32dp" android:layout_height="1dp" android:background="@color/colorPrimary" android:alpha="0.3" android:layout_marginEnd="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_reg_step3_tag"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="10sp"
                    android:fontFamily="@font/manrope_bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <!-- Legal Business Name -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_reg_step3_legal_name_label"
                        android:textColor="@color/colorOutline"
                        android:textSize="11sp"
                        android:fontFamily="@font/manrope_bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp"
                        android:layout_marginStart="4dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_legal_name"
                        style="@style/Widget.Aura.TextInputLayout"
                        app:hintEnabled="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_legal_name"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:hint="@string/brand_reg_step3_legal_name_hint"
                            android:textColorHint="@color/colorOutline"
                            android:fontFamily="@font/manrope_medium"
                            android:textColor="@color/colorOnSurface" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Representative Name -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_reg_step3_rep_name_label"
                        android:textColor="@color/colorOutline"
                        android:textSize="11sp"
                        android:fontFamily="@font/manrope_bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp"
                        android:layout_marginStart="4dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_rep_name"
                        style="@style/Widget.Aura.TextInputLayout"
                        app:hintEnabled="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_rep_name"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:hint="@string/brand_reg_step3_rep_name_hint"
                            android:textColorHint="@color/colorOutline"
                            android:fontFamily="@font/manrope_medium"
                            android:textColor="@color/colorOnSurface" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Company email -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/brand_reg_step3_company_email_label"
                android:textColor="@color/colorOutline"
                android:textSize="11sp"
                android:fontFamily="@font/manrope_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_company_email"
                style="@style/Widget.Aura.TextInputLayout"
                app:hintEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_company_email"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="@string/brand_reg_step3_company_email_hint"
                    android:textColorHint="@color/colorOutline"
                    android:inputType="textEmailAddress"
                    android:fontFamily="@font/manrope_medium"
                    android:textColor="@color/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Legal Documentation section label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View android:layout_width="32dp" android:layout_height="1dp" android:background="@color/colorPrimary" android:alpha="0.3" android:layout_marginEnd="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_reg_step3_doc_section"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="10sp"
                    android:fontFamily="@font/manrope_bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.2" />
            </LinearLayout>

            <!-- File upload zone -->
            <FrameLayout
                android:id="@+id/layout_file_upload"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_upload_zone"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:id="@+id/layout_file_prompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_circle_primary_tint"
                        android:backgroundTint="@color/colorPrimaryContainer"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_upload"
                            android:tint="@color/colorPrimary"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_reg_step3_upload_title"
                        android:textColor="@color/colorOnSurface"
                        android:textSize="16sp"
                        android:fontFamily="@font/manrope_bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_reg_step3_upload_subtitle"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:fontFamily="@font/manrope_medium"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_file_selected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:padding="8dp"
                    android:gravity="center"
                    android:textColor="@color/colorPrimary"
                    android:textSize="13sp"
                    android:fontFamily="@font/manrope_bold"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Social Presence section label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View android:layout_width="32dp" android:layout_height="1dp" android:background="@color/colorPrimary" android:alpha="0.3" android:layout_marginEnd="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_reg_step3_social_section"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="10sp"
                    android:fontFamily="@font/manrope_bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.2" />
            </LinearLayout>

            <!-- LinkedIn input row -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                style="@style/Widget.Aura.Card"
                app:cardBackgroundColor="@color/colorSurfaceContainerLow"
                app:cardCornerRadius="32dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorOutlineVariant"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="24dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_surface"
                        android:backgroundTint="@color/colorSurfaceContainerHighest"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_share"
                            android:tint="@color/colorSecondary"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <EditText
                        android:id="@+id/et_linkedin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/brand_reg_step3_linkedin_hint"
                        android:textColor="@color/colorOnSurface"
                        android:textColorHint="@color/colorOutline"
                        android:fontFamily="@font/manrope_medium"
                        android:textSize="13sp"
                        android:paddingStart="8dp"
                        android:inputType="textUri" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Twitter input row -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                style="@style/Widget.Aura.Card"
                app:cardBackgroundColor="@color/colorSurfaceContainerLow"
                app:cardCornerRadius="32dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorOutlineVariant"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="24dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_surface"
                        android:backgroundTint="@color/colorSurfaceContainerHighest"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_send"
                            android:tint="@color/colorSecondary"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <EditText
                        android:id="@+id/et_twitter"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/brand_reg_step3_twitter_hint"
                        android:textColor="@color/colorOnSurface"
                        android:textColorHint="@color/colorOutline"
                        android:fontFamily="@font/manrope_medium"
                        android:textSize="13sp"
                        android:paddingStart="8dp"
                        android:inputType="text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Security protocol info card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Aura.Card"
                app:cardBackgroundColor="@color/colorSurfaceContainerLow"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="@dimen/icon_size_md"
                            android:layout_height="@dimen/icon_size_md"
                            android:src="@android:drawable/ic_lock_lock"
                            android:tint="@color/colorTertiary"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/brand_reg_security_protocol_title"
                            android:textColor="@color/colorOnSurface"
                            android:textSize="12sp"
                            android:fontFamily="@font/manrope_bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.08" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_reg_security_protocol_body"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:fontFamily="@font/manrope_medium"
                        android:lineSpacingMultiplier="1.5" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Standardized Bottom Actions -->
    <include
        android:id="@+id/layout_bottom_nav"
        layout="@layout/component_reg_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
